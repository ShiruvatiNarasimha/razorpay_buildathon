# ==============================================================================
# AgentPay Control Plane — Environment Configuration Template
# Copy this file to .env before starting the backend server:
# cp .env.example .env
# ==============================================================================

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Optional: PostgreSQL / Neon / Supabase)
# Falls back to high-speed in-memory store if database is offline or not configured
DATABASE_URL="postgresql://user:password@localhost:5432/agentpay?sslmode=disable"

# Google Gemini API Configuration (Natural Language Intent Reasoning)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.7-flash"

# Razorpay Test Mode Credentials (Optional: Falls back to sandbox simulator if not set)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Default Demo User Context
DEFAULT_USER_ID="usr_demo_fintech_01"
